# Keep this configuration compatible with scripts/requirements-format.txt.
line_width = 120
tab_size = 4
max_pargs_hwrap = 6
max_subgroups_hwrap = 2
separate_ctrl_name_with_space = False
separate_fn_name_with_space = False
dangle_parens = True
max_prefix_chars = 2
max_lines_hwrap = 2
line_ending = 'auto'
command_case = 'canonical'
keyword_case = 'unchanged'

# Preserve argument order and comment text in the mechanical formatting pass.
enable_sort = False
autosort = False
enable_markup = False
